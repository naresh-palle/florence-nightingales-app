datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEAM_LEAD
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum CustomerStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  ASSESSMENT_PENDING
  QUOTATION_SENT
  CONVERTED
  LOST
}

enum AssignmentStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

// ── ORGANIZATION & BRANCH ────────────────────────────────────────────────────

model Organization {
  id         String   @id @default(uuid())
  name       String
  branches   Branch[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Branch {
  id       String  @id @default(uuid())
  name     String
  location String?

  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  teams Team[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ── CORE ENTITIES ────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  phone         String?
  password_hash String?
  role          Role
  status        UserStatus @default(PENDING)
  full_name     String
  designation   String?
  qualification String?
  experience    String?
  joining_date  DateTime?

  team_id       String?
  team          Team?   @relation("TeamMembers", fields: [team_id], references: [id])
  leading_teams Team[]  @relation("TeamLead")

  assignments       CareAssignment[]
  tasks             Task[]
  attendance        Attendance[]
  payments_received Payment[]         @relation("ReceivedBy")
  reminders_sent    PaymentReminder[] @relation("SentBy")
  audit_logs_actor  AuditLog[]        @relation("Actor")

  // HR Reverse relations
  documents       EmployeeDocument[]
  certifications  Certification[]
  leave_requests  LeaveRequest[]
  approved_leaves LeaveRequest[]     @relation("ApprovedLeaves")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Team {
  id          String     @id @default(uuid())
  name        String
  description String?
  status      UserStatus @default(ACTIVE)

  branch_id String?
  branch    Branch? @relation(fields: [branch_id], references: [id])

  team_lead_id String?
  team_lead    User?   @relation("TeamLead", fields: [team_lead_id], references: [id])

  employees   User[]           @relation("TeamMembers")
  customers   Customer[]
  enquiries   Enquiry[]
  assignments CareAssignment[]
  tasks       Task[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ── CRM & CUSTOMER ───────────────────────────────────────────────────────────

model Enquiry {
  id                   String        @id @default(uuid())
  enquiry_number       String        @unique
  customer_name        String
  phone                String
  email                String?
  service_required     String?
  location             String?
  preferred_start_date DateTime?
  expected_duration    String?
  lead_source          String?
  follow_up_date       DateTime?
  status               EnquiryStatus @default(NEW)
  notes                String?

  assigned_team_id String?
  assigned_team    Team?   @relation(fields: [assigned_team_id], references: [id])

  quotation Quotation?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Customer {
  id                String  @id @default(uuid())
  customer_number   String? @unique
  full_name         String
  phone             String
  email             String?
  address           String?
  emergency_contact String?

  // Legacy fields (will eventually migrate to ServicePlan/Patient)
  service_type       String?
  service_start_date DateTime?
  service_end_date   DateTime?

  status CustomerStatus @default(ACTIVE)
  notes  String?

  team_id String
  team    Team   @relation(fields: [team_id], references: [id])

  patients    Patient[]
  assignments CareAssignment[]
  invoices    Invoice[]
  payments    Payment[]
  reminders   PaymentReminder[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Patient {
  id                String  @id @default(uuid())
  patient_number    String  @unique
  full_name         String
  age               Int?
  gender            String?
  address           String?
  emergency_contact String?
  care_requirements String?
  mobility_info     String?
  allergies         String?
  notes             String?

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  assignments CareAssignment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ── OPERATIONS ───────────────────────────────────────────────────────────────

model CareAssignment {
  id                String           @id @default(uuid())
  assignment_number String?          @unique
  service_type      String
  start_date        DateTime
  end_date          DateTime?
  start_time        String?
  end_time          String?
  status            AssignmentStatus @default(PENDING)
  notes             String?

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  patient_id String?
  patient    Patient? @relation(fields: [patient_id], references: [id])

  employee_id String?
  employee    User?   @relation(fields: [employee_id], references: [id])

  team_id String
  team    Team   @relation(fields: [team_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  priority    String?
  due_date    DateTime?
  status      TaskStatus @default(TODO)

  employee_id String
  employee    User   @relation(fields: [employee_id], references: [id])
  team_id     String
  team        Team   @relation(fields: [team_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Attendance {
  id            String    @id @default(uuid())
  date          DateTime
  check_in      DateTime?
  check_out     DateTime?
  location_data String?

  employee_id String
  employee    User   @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ── FINANCE ──────────────────────────────────────────────────────────────────

model Invoice {
  id                   String   @id @default(uuid())
  invoice_number       String   @unique
  service_period_start DateTime
  service_period_end   DateTime
  billing_date         DateTime
  due_date             DateTime

  total_amount Decimal       @db.Decimal(10, 2)
  status       InvoiceStatus @default(DRAFT)
  notes        String?

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])

  payments  Payment[]
  reminders PaymentReminder[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Payment {
  id                    String        @id @default(uuid())
  payment_reference     String        @unique
  amount                Decimal       @db.Decimal(10, 2)
  payment_date          DateTime
  payment_method        PaymentMethod
  transaction_reference String?
  status                PaymentStatus @default(PENDING)
  notes                 String?

  invoice_id     String
  invoice        Invoice  @relation(fields: [invoice_id], references: [id])
  customer_id    String
  customer       Customer @relation(fields: [customer_id], references: [id])
  received_by_id String
  received_by    User     @relation("ReceivedBy", fields: [received_by_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PaymentReminder {
  id                  String              @id @default(uuid())
  outstanding_at_time Decimal             @db.Decimal(10, 2)
  channel             NotificationChannel
  message_type        String?
  sent_time           DateTime            @default(now())
  delivery_status     String?

  customer_id String
  customer    Customer @relation(fields: [customer_id], references: [id])
  invoice_id  String
  invoice     Invoice  @relation(fields: [invoice_id], references: [id])
  sender_id   String
  sender      User     @relation("SentBy", fields: [sender_id], references: [id])
}

// ── SERVICE CATALOG & QUOTING ────────────────────────────────────────────────

model ServiceCategory {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  services    ServiceCatalog[]
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
}

model ServiceCatalog {
  id           String  @id @default(uuid())
  name         String
  description  String?
  base_price   Decimal @db.Decimal(10, 2)
  billing_unit String

  category_id String
  category    ServiceCategory @relation(fields: [category_id], references: [id])

  quotation_items QuotationItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Quotation {
  id               String    @id @default(uuid())
  quotation_number String    @unique
  total_amount     Decimal   @db.Decimal(10, 2)
  status           String    @default("DRAFT")
  valid_until      DateTime?
  notes            String?

  enquiry_id String  @unique
  enquiry    Enquiry @relation(fields: [enquiry_id], references: [id])

  items QuotationItem[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model QuotationItem {
  id          String  @id @default(uuid())
  quantity    Int     @default(1)
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  quotation_id String
  quotation    Quotation @relation(fields: [quotation_id], references: [id])

  service_id String
  service    ServiceCatalog @relation(fields: [service_id], references: [id])
}

// ── HR & EMPLOYEE MANAGEMENT ─────────────────────────────────────────────────

model EmployeeDocument {
  id            String    @id @default(uuid())
  document_type String
  document_url  String
  is_verified   Boolean   @default(false)
  expiry_date   DateTime?

  employee_id String
  employee    User   @relation(fields: [employee_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Certification {
  id                String    @id @default(uuid())
  name              String
  issuing_authority String
  issue_date        DateTime
  expiry_date       DateTime?
  credential_id     String?

  employee_id String
  employee    User   @relation(fields: [employee_id], references: [id])
}

model LeaveRequest {
  id         String   @id @default(uuid())
  leave_type String
  start_date DateTime
  end_date   DateTime
  reason     String
  status     String   @default("PENDING")

  employee_id    String
  employee       User    @relation(fields: [employee_id], references: [id])
  approved_by_id String?
  approved_by    User?   @relation("ApprovedLeaves", fields: [approved_by_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ── SYSTEM ───────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entity_type String
  entity_id   String
  timestamp   DateTime @default(now())
  ip_address  String?
  device_id   String?
  metadata    String?
  result      String

  actor_user_id String?
  actor         User?   @relation("Actor", fields: [actor_user_id], references: [id])
}

model OrganizationSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
}
